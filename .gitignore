# repo นี้เก็บเฉพาะ "กฎหมาย" ไม่เก็บ "พลเมือง"
# แต่ละโปรเจกต์เป็น git repo อิสระของตัวเอง (ธรรมนูญข้อ 1)
# จึงต้อง ignore ทุกอย่างก่อน แล้วค่อยเปิดเฉพาะไฟล์ของรัฐ

/*

!/.claude/
!/.workspace/
!/CLAUDE.md
!/PROJECTS.md
!/.nvmrc
!/.editorconfig
!/.gitignore
!/.gitattributes

# _docs/ ไม่เข้า git — อาจมีเอกสาร/สเปรดชีตงานจริงที่ไม่ควรขึ้น remote

.claude/settings.local.json
.env
.env.*
!.env.example
