//| RangeFadeTypes.mqh                                                 |
//| ชนิดข้อมูลที่ input ต้องใช้ จึงต้องประกาศก่อนบล็อก input ของ EA      |
//+------------------------------------------------------------------+
#ifndef RANGEFADE_TYPES_MQH
#define RANGEFADE_TYPES_MQH

enum ENUM_RF_TP
{
   RF_TP_MEAN = 0, // ปิดที่ค่ากลางของแบนด์ (ระยะไม่คงที่)
   RF_TP_ATR  = 1, // ปิดที่ ATR x ตัวคูณ
   RF_TP_R    = 2  // ปิดที่ R x ตัวคูณ (R = ระยะ SL)
};

enum ENUM_RF_TREND
{
   RF_TREND_OFF     = 0, // ไม่กรองเทรนด์
   RF_TREND_WITH    = 1, // เข้าเฉพาะฝั่งเดียวกับเทรนด์ (ซื้อย่อในขาขึ้น)
   RF_TREND_AGAINST = 2  // เข้าเฉพาะฝั่งสวนเทรนด์ (สวนของจริง)
};

#endif
