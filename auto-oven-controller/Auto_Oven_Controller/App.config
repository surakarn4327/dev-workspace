<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

	<appSettings>
		<add key="OvenName" value="ตู้อบ 1" />
		<add key="OvenAddress" value="1" />
		<!-- True = ส่งคำสั่งฮีตเตอร์/พัดลม (W0.00, W0.01) และสัญญาณชีพจร (W0.02) ไป PLC Omron CP1L ผ่าน FINS/UDP แล้ว ladder ใน PLC สั่งขา 100.00 (ฮีตเตอร์) และ 100.02 (พัดลม) ใช้ก่อน Modbus และตัวจำลอง -->
		<add key="UseFins" value="True" />
		<add key="FinsHost" value="192.168.250.1" />
		<add key="FinsPort" value="9600" />
		<add key="FinsPlcNode" value="1" />
		<add key="FinsPcNode" value="10" />
		<!-- True = สั่งวาล์ว/พัดลมใน Factory I/O ผ่าน Modbus TCP, False = ใช้ตัวจำลองในโปรแกรม (มีผลเมื่อ UseFins เป็น False หรือต่อ PLC ไม่ติด) -->
		<add key="UseModbus" value="False" />
		<add key="ModbusHost" value="192.168.1.155" />
		<add key="ModbusPort" value="502" />
	</appSettings>

</configuration>
