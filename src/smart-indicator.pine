//@version=5
indicator("Smart Indicator", overlay=true, max_lines_count=500, max_labels_count=500, dynamic_requests=true)

// === หน้าตั้งค่า (ภาษาไทย) — จัดกลุ่มตาม style.md ===
grpCrt = "ตั้งค่า CRT หลัก"
htf = input.timeframe("60", "ไทม์เฟรมแท่งคุม (Control Candle)", tooltip="แท่งใหญ่ที่ใช้กำหนดกรอบบน-ล่าง (CTH/CTL) เช่น 60 = แท่ง 1 ชั่วโมง", group=grpCrt)
ltf = input.timeframe("5", "ไทม์เฟรมแท่งย่อย", tooltip="ใช้ตอนเปิดดูชาร์ตไทม์เฟรมใหญ่ (เท่ากับหรือใหญ่กว่าแท่งคุม) — สคริปต์จะดึงแท่งย่อยนี้มาไล่เช็ค sweep แทน", group=grpCrt)

grpHtfLine = "เส้นตรวจสอบ"
showHtfDivider = input.bool(true, "แสดงเส้น", inline="htfline", tooltip="เส้นแนวตั้งที่ขีดคั่นตอนแท่งคุมแต่ละแท่งปิด", group=grpHtfLine)
htfLineColor = input.color(color.blue, "สี", inline="htfline", group=grpHtfLine)
htfLineWidth = input.int(1, "ความหนา", minval=1, inline="htfline", group=grpHtfLine)

grpRangeLine = "เส้นกรอบ CTH/CTL"
hlColor = input.color(color.black, "สี", inline="hl", group=grpRangeLine)
hlWidth = input.int(1, "ความหนา", minval=1, inline="hl", tooltip="เส้นแนวนอนคู่บน-ล่างของกรอบที่กำลังเฝ้าดู sweep", group=grpRangeLine)

grpCircle = "วงกลมจุด Sweep"
showSweepCircle = input.bool(true, "แสดง", inline="circle", tooltip="วงกลมจางๆ ที่จุด high/low สุดขั้วของ sweep — ค้างไว้ดูย้อนหลังได้แม้ setup จะรู้ผลแล้ว", group=grpCircle)
circleColor = input.color(color.new(color.orange, 80), "สี", inline="circle", group=grpCircle)

grpShow = "แสดง/ซ่อนผลลัพธ์"
showOngoing = input.bool(true, "กำลังดำเนินอยู่ (Sweep)", tooltip="แสดงเส้นกรอบระหว่างที่ยังไม่รู้ผลแพ้ชนะ", group=grpShow)
showSuccess = input.bool(true, "สำเร็จ (Success)", tooltip="แสดงเส้นกรอบ + ป้ายเขียว เมื่อราคาย้อนไปแตะฝั่งตรงข้ามได้สำเร็จ", group=grpShow)
showFailed = input.bool(true, "ล้มเหลว (Failed)", tooltip="แสดงเส้นกรอบ + ป้ายแดง เมื่อราคาทะลุกรอบซ้ำแล้วปิดออกนอกกรอบ", group=grpShow)

isNewHtfBar = timeframe.change(htf)

if isNewHtfBar and bar_index > 0 and showHtfDivider
    // close ของแท่ง HTF ก่อนหน้า = แท่งก่อนแท่งปัจจุบัน
    line.new(x1=bar_index - 1, y1=high[1], x2=bar_index - 1, y2=low[1], extend=extend.both, color=htfLineColor, width=htfLineWidth)

// === Step 2/3: CRT range (CTH/CTL) + sweep detection ===
// กรอบ (CTH/CTL) จะ "เฝ้าดู sweep" ต่อเนื่องได้ไม่จำกัดเวลา ไม่ reset ทุกแท่ง 1h
// จะเปลี่ยนไปใช้แท่งคุมใหม่ก็ต่อเมื่อกรอบเดิม "รู้ผล" แล้วเท่านั้น (success/failed หรือยังไม่เคย sweep เลย)
// ทำงานได้ทั้งตอนเปิดชาร์ต LTF (ดูทีละแท่งย่อยจริง) และตอนเปิดชาร์ต HTF (ดึงแท่งย่อยผ่าน request.security_lower_tf)
// สถานะ CRT ทั้งหมดถูกรวมเป็น type เดียว (CrtState) และ method เดียว (processSubBar/adopt) ที่ทั้งสองโหมดเรียกใช้ร่วมกัน
// เพื่อไม่ให้กฎ sweep/touch/fail มีสองชุดที่ต้องแก้พร้อมกันเหมือนก่อนหน้านี้

[htfHigh, htfLow, htfOpen, htfClose] = request.security(syminfo.tickerid, htf, [high, low, open, close], lookahead=barmerge.lookahead_off)

onHtfChart = timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds(htf)

// ตำแหน่งแท่งย่อยที่ทำ high/low สุดของแท่ง HTF ที่กำลังฟอร์มตัวอยู่ (candidate แท่งคุมถัดไป) — ใช้เฉพาะโหมด LTF
var float curCandleHigh = na
var int curCandleHighBar = na
var float curCandleLow = na
var int curCandleLowBar = na

// สถานะกรอบ CRT ทั้งหมดรวมเป็นก้อนเดียว (reference type — method แก้ field ได้ตรงๆ)
type CrtState
    float rangeHigh = na
    float rangeLow = na
    int rangeHighBar = na // แท่งที่ทำ high สุดของแท่งคุม (หัวเส้น CTH)
    int rangeLowBar = na // แท่งที่ทำ low สุดของแท่งคุม (หัวเส้น CTL)
    bool rangeBullish = na
    string state = na // "none" / "swept" / "success" / "failed"
    string sweptSide = na // "low" / "high"
    float sweepPoint = na
    int sweepPointBar = na // แท่งที่ทำจุดสุดขั้วจริง (ไม่ใช่แท่งที่ยืนยัน) — ใช้วางวงกลมให้ตรงตำแหน่ง
    label sweepCircle = na // วงกลมส้มจางๆ ที่จุด sweep (high/low สุดขั้ว)
    line cthLine = na
    line ctlLine = na
    // ติดตาม "จุดทะลุ" ระหว่างชั่วโมงยังไม่จบ (ยังไม่ยืนยันเป็น sweep จนกว่าแท่งสุดท้ายของชั่วโมงจะปิดกลับเข้ากรอบได้)
    bool pendingSwept = false
    string pendingSide = na
    float pendingPoint = na
    int pendingPointBar = na // แท่งที่ทำจุด pending สุดขั้วจริง
    bool pendingOppositeTouched = false // ถ้าแตะฝั่งตรงข้ามระหว่าง pending = ไม่เกิด CRT เลย
    // ติดตามว่ามีการทะลุ CTH/CTL ซ้ำระหว่างชั่วโมงหลัง sweep ยืนยันแล้ว (รอแท่งสุดท้ายปิดตัดสิน fail เหมือนกัน)
    bool rePierced = false
    // จุดทะลุซ้ำ "ผู้ท้าชิง" — จะมาแทน sweepPoint จริงก็ต่อเมื่อกลับเข้ากรอบได้สำเร็จ (กฎข้อ 6) ถ้าล้มเหลวทิ้งไปเลย ไม่แตะ sweepPoint เดิม
    float rePierceCandidate = na
    int rePierceCandidateBar = na

method canAdopt(CrtState this) =>
    na(this.state) or this.state == "none" or this.state == "success" or this.state == "failed"

// รับแท่งคุมใหม่ (ล้างสถานะ sweep เดิมทั้งหมด) — ใช้ทั้งโหมด HTF-chart และ native
method adopt(CrtState this, float rHigh, float rLow, int rHighBar, int rLowBar, bool bullish) =>
    this.rangeHigh := rHigh
    this.rangeLow := rLow
    this.rangeHighBar := rHighBar
    this.rangeLowBar := rLowBar
    this.rangeBullish := bullish
    this.state := "none"
    this.sweptSide := na
    this.sweepPoint := na
    this.sweepPointBar := na
    this.sweepCircle := na
    this.cthLine := na
    this.ctlLine := na
    this.pendingSwept := false
    this.pendingSide := na
    this.pendingPoint := na
    this.pendingPointBar := na
    this.pendingOppositeTouched := false
    this.rePierced := false
    this.rePierceCandidate := na
    this.rePierceCandidateBar := na

// ตัวจักรกฎ CRT ตัวเดียว — เรียกทีละ "แท่งย่อย" (h_/l_/c_ ของแท่งย่อยนั้น)
// isBoundary = true เฉพาะแท่งย่อยสุดท้ายของชั่วโมง (ที่ปิดยืนยันแล้ว) เท่านั้น ถึงจะตัดสิน sweep/fail
// โหมด HTF-chart เรียกใน for loop ต่อแท่งย่อยจริง, โหมด native เรียก 2 ครั้งต่อแท่ง (boundary ด้วยข้อมูล [1], continuous ด้วยข้อมูลแท่งปัจจุบัน)
method processSubBar(CrtState this, float h_, float l_, float c_, bool isBoundary, int barIdx, bool showOngoing, bool showSuccess, bool showFailed, color hlColor, int hlWidth, bool showSweepCircle, color circleColor) =>
    if not na(this.rangeHigh)
        if this.state == "swept" and showOngoing
            if na(this.cthLine)
                this.cthLine := line.new(this.rangeHighBar, this.rangeHigh, barIdx, this.rangeHigh, color=hlColor, width=hlWidth)
                this.ctlLine := line.new(this.rangeLowBar, this.rangeLow, barIdx, this.rangeLow, color=hlColor, width=hlWidth)
            else
                line.set_x2(this.cthLine, barIdx)
                line.set_x2(this.ctlLine, barIdx)

        if this.state == "none"
            // ไล่หาจุดทะลุระหว่างชั่วโมง (ยังไม่ยืนยัน) — เก็บจุดสุดขั้วไว้ก่อน
            if not this.pendingSwept
                if this.rangeBullish and h_ > this.rangeHigh
                    this.pendingSwept := true
                    this.pendingSide := "high"
                    this.pendingPoint := h_
                    this.pendingPointBar := barIdx
                else if not this.rangeBullish and l_ < this.rangeLow
                    this.pendingSwept := true
                    this.pendingSide := "low"
                    this.pendingPoint := l_
                    this.pendingPointBar := barIdx
            else
                if this.pendingSide == "high" and h_ > this.pendingPoint
                    this.pendingPoint := h_
                    this.pendingPointBar := barIdx
                if this.pendingSide == "low" and l_ < this.pendingPoint
                    this.pendingPoint := l_
                    this.pendingPointBar := barIdx
                // ถ้าแตะฝั่งตรงข้ามระหว่าง pending (ก่อนแท่งสุดท้ายปิด) = ไม่เหลือช่องว่างให้วิ่ง ไม่เกิด CRT เลย
                if (this.pendingSide == "low" and h_ >= this.rangeHigh) or (this.pendingSide == "high" and l_ <= this.rangeLow)
                    this.pendingOppositeTouched := true

            // ยืนยัน sweep ได้ก็ต่อเมื่อแท่งย่อยสุดท้ายของชั่วโมงปิดกลับเข้ากรอบได้ และไม่เคยแตะฝั่งตรงข้ามมาก่อนเลย
            if isBoundary and this.state == "none"
                if this.pendingSwept and not this.pendingOppositeTouched and ((this.pendingSide == "high" and c_ <= this.rangeHigh) or (this.pendingSide == "low" and c_ >= this.rangeLow))
                    this.state := "swept"
                    this.sweptSide := this.pendingSide
                    this.sweepPoint := this.pendingPoint
                    this.sweepPointBar := this.pendingPointBar
                    if showSweepCircle
                        this.sweepCircle := label.new(this.pendingPointBar, this.pendingPoint, "", style=label.style_circle, color=circleColor, size=size.small)
                // ไม่ปิดกลับเข้ากรอบ หรือเคยแตะฝั่งตรงข้ามมาก่อน = ไม่นับเป็น CRT เลย ทิ้ง pending ทิ้ง
                this.pendingSwept := false
                this.pendingSide := na
                this.pendingPoint := na
                this.pendingPointBar := na
                this.pendingOppositeTouched := false
        else if this.state == "swept"
            touchOpposite = (this.sweptSide == "low" and h_ >= this.rangeHigh) or (this.sweptSide == "high" and l_ <= this.rangeLow)
            if touchOpposite
                this.state := "success"
                // ไม่ลบ sweepCircle — ปล่อยค้างไว้เป็นร่องรอย setup อดีต
                if showSuccess
                    if na(this.cthLine)
                        line.new(this.rangeHighBar, this.rangeHigh, barIdx, this.rangeHigh, color=hlColor, width=hlWidth)
                        line.new(this.rangeLowBar, this.rangeLow, barIdx, this.rangeLow, color=hlColor, width=hlWidth)
                    else
                        line.set_x2(this.cthLine, barIdx)
                        line.set_x2(this.ctlLine, barIdx)
                else if not na(this.cthLine)
                    line.delete(this.cthLine)
                    line.delete(this.ctlLine)
                    this.cthLine := na
                    this.ctlLine := na
                if showSuccess
                    label.new(barIdx, this.sweptSide == "low" ? this.rangeHigh : this.rangeLow, "Success", style=this.sweptSide == "low" ? label.style_label_down : label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
            else
                // ทะลุ CTH/CTL ซ้ำระหว่างชั่วโมง — เก็บไว้ก่อน รอแท่งสุดท้ายปิดค่อยตัดสิน fail
                beyondSweep = (this.sweptSide == "low" and l_ < this.rangeLow) or (this.sweptSide == "high" and h_ > this.rangeHigh)
                if beyondSweep
                    this.rePierced := true
                    baseline = na(this.rePierceCandidate) ? this.sweepPoint : this.rePierceCandidate
                    newCandidate = this.sweptSide == "low" ? math.min(baseline, l_) : math.max(baseline, h_)
                    if newCandidate != baseline
                        this.rePierceCandidate := newCandidate
                        this.rePierceCandidateBar := barIdx
                if isBoundary and this.rePierced
                    closedInside = (this.sweptSide == "low" and c_ >= this.rangeLow) or (this.sweptSide == "high" and c_ <= this.rangeHigh)
                    if closedInside
                        // ทะลุแล้วกลับเข้ามาสำเร็จ = จุด sweep ขยับมาที่จุดสุดขั้วใหม่นี้จริง (กฎข้อ 6)
                        this.rePierced := false
                        if not na(this.rePierceCandidate)
                            this.sweepPoint := this.rePierceCandidate
                            this.sweepPointBar := this.rePierceCandidateBar
                            if not na(this.sweepCircle)
                                label.set_xy(this.sweepCircle, this.sweepPointBar, this.sweepPoint)
                        this.rePierceCandidate := na
                        this.rePierceCandidateBar := na
                    else
                        // ทะลุแล้วปิดค้างนอกกรอบ = fail จุดทะลุนี้ไม่นับเป็น sweep point ใหม่ ทิ้งผู้ท้าชิงไป คงจุด sweep เดิม
                        this.state := "failed"
                        this.rePierced := false
                        this.rePierceCandidate := na
                        this.rePierceCandidateBar := na
                        // ไม่ลบ sweepCircle — ปล่อยค้างไว้เป็นร่องรอย setup อดีต
                        if showFailed
                            if na(this.cthLine)
                                line.new(this.rangeHighBar, this.rangeHigh, barIdx, this.rangeHigh, color=hlColor, width=hlWidth)
                                line.new(this.rangeLowBar, this.rangeLow, barIdx, this.rangeLow, color=hlColor, width=hlWidth)
                            else
                                line.set_x2(this.cthLine, barIdx)
                                line.set_x2(this.ctlLine, barIdx)
                        else if not na(this.cthLine)
                            line.delete(this.cthLine)
                            line.delete(this.ctlLine)
                            this.cthLine := na
                            this.ctlLine := na
                        if showFailed
                            label.new(barIdx, this.sweptSide == "low" ? l_ : h_, "Failed", style=this.sweptSide == "low" ? label.style_label_down : label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
    true

var CrtState state = CrtState.new()

if onHtfChart
    // โหมดชาร์ต HTF: แท่งก่อนหน้า (native) คือแท่งคุมที่เพิ่งปิด ไม่ต้องพึ่ง request.security
    if bar_index > 0 and state.canAdopt()
        state.adopt(high[1], low[1], bar_index - 1, bar_index - 1, close[1] > open[1])

    // ดึงแท่งย่อย (เช่น 5m) ที่ประกอบเป็นแท่ง HTF ปัจจุบัน มาไล่ตรวจ sweep ทีละแท่ง
    [subHigh, subLow, subClose] = request.security_lower_tf(syminfo.tickerid, ltf, [high, low, close])
    n = array.size(subHigh)
    if not na(state.rangeHigh) and n > 0
        for i = 0 to n - 1
            h_ = array.get(subHigh, i)
            l_ = array.get(subLow, i)
            c_ = array.get(subClose, i)
            isLastSubBar = i == n - 1
            isBoundary = isLastSubBar and barstate.isconfirmed
            state.processSubBar(h_, l_, c_, isBoundary, bar_index, showOngoing, showSuccess, showFailed, hlColor, hlWidth, showSweepCircle, circleColor)
else
    if isNewHtfBar and bar_index > 0
        // ยืนยัน sweep/fail ของกรอบเดิมด้วยข้อมูลแท่งสุดท้ายที่เพิ่งปิด (close[1]/low[1]/high[1]) ก่อนพิจารณารับแท่งคุมใหม่
        if not na(state.rangeHigh)
            state.processSubBar(high[1], low[1], close[1], true, bar_index - 1, showOngoing, showSuccess, showFailed, hlColor, hlWidth, showSweepCircle, circleColor)

        // เปลี่ยนไปใช้แท่งที่ปิดล่าสุดเป็นแท่งคุมใหม่ ได้ก็ต่อเมื่อกรอบเดิมรู้ผลแล้ว (หรือยังไม่เคย sweep)
        // ถ้ากรอบเดิมยัง "swept" ไม่รู้ผล ไม่แตะแท่งใหม่นี้ เฝ้ากรอบเดิมต่อ
        if state.canAdopt()
            state.adopt(curCandleHigh, curCandleLow, curCandleHighBar, curCandleLowBar, htfClose[1] > htfOpen[1])

        // เริ่มติดตามแท่ง HTF ใหม่ที่กำลังฟอร์มตัว (candidate สำหรับรอบหน้า)
        curCandleHigh := high
        curCandleHighBar := bar_index
        curCandleLow := low
        curCandleLowBar := bar_index
    else
        // อัปเดตตำแหน่ง high/low สุดของแท่ง HTF ที่กำลังฟอร์มตัว
        if na(curCandleHigh) or high > curCandleHigh
            curCandleHigh := high
            curCandleHighBar := bar_index
        if na(curCandleLow) or low < curCandleLow
            curCandleLow := low
            curCandleLowBar := bar_index

    // เช็ค pending/touchOpposite/beyondSweep ของแท่งปัจจุบัน — เขียนครั้งเดียว รันทุกแท่งไม่ว่าจะเป็นแท่งแรกของชั่วโมงหรือไม่
    // (กันบั๊กแบบที่เคยพลาด: แท่งแรกของชั่วโมงไม่ถูกเช็คเพราะ logic ซ้ำกันอยู่คนละที่)
    state.processSubBar(high, low, close, false, bar_index, showOngoing, showSuccess, showFailed, hlColor, hlWidth, showSweepCircle, circleColor)
