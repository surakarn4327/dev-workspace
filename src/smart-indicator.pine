//@version=5
indicator("Smart Indicator", overlay=true, max_lines_count=500, dynamic_requests=true)

// === Step 1: HTF candle open/close vertical lines ===
htf = input.timeframe("60", "Higher Timeframe")
htfLineColor = input.color(color.blue, "HTF Line Color")
htfLineWidth = input.int(1, "HTF Line Width", minval=1)

isNewHtfBar = timeframe.change(htf)

if isNewHtfBar and bar_index > 0
    // close ของแท่ง HTF ก่อนหน้า = แท่งก่อนแท่งปัจจุบัน
    line.new(x1=bar_index - 1, y1=high[1], x2=bar_index - 1, y2=low[1], extend=extend.both, color=htfLineColor, width=htfLineWidth)

// === Step 2/3: CRT range (CTH/CTL) + sweep detection ===
// กรอบ (CTH/CTL) จะ "เฝ้าดู sweep" ต่อเนื่องได้ไม่จำกัดเวลา ไม่ reset ทุกแท่ง 1h
// จะเปลี่ยนไปใช้แท่งคุมใหม่ก็ต่อเมื่อกรอบเดิม "รู้ผล" แล้วเท่านั้น (success/failed หรือยังไม่เคย sweep เลย)
// ทำงานได้ทั้งตอนเปิดชาร์ต LTF (ดูทีละแท่งย่อยจริง) และตอนเปิดชาร์ต HTF (ดึงแท่งย่อยผ่าน request.security_lower_tf)
hlColor = input.color(color.black, "HTF High/Low Color")
hlWidth = input.int(1, "HTF High/Low Width", minval=1)
ltf = input.timeframe("5", "Lower Timeframe (ใช้ตอนเปิดชาร์ต HTF)")

[htfHigh, htfLow, htfOpen, htfClose] = request.security(syminfo.tickerid, htf, [high, low, open, close], lookahead=barmerge.lookahead_off)

showOngoing = input.bool(true, "แสดง CRT ที่กำลังดำเนินอยู่")
showSuccess = input.bool(true, "แสดง CRT สำเร็จ")
showFailed = input.bool(true, "แสดง CRT ล้มเหลว")

onHtfChart = timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds(htf)

// ตำแหน่งแท่งย่อยที่ทำ high/low สุดของแท่ง HTF ที่กำลังฟอร์มตัวอยู่ (candidate แท่งคุมถัดไป) — ใช้เฉพาะโหมด LTF
var float curCandleHigh = na
var int curCandleHighBar = na
var float curCandleLow = na
var int curCandleLowBar = na

// สถานะกรอบ CRT ที่กำลังเฝ้าอยู่ (ใช้ร่วมกันทั้งสองโหมด)
var float rangeHigh = na
var float rangeLow = na
var int rangeHighBar = na // แท่งที่ทำ high สุดของแท่งคุม (หัวเส้น CTH)
var int rangeLowBar = na // แท่งที่ทำ low สุดของแท่งคุม (หัวเส้น CTL)
var bool rangeBullish = na
var string crtState = na // "none" / "swept" / "success" / "failed"
var string sweptSide = na // "low" / "high"
var float sweepPoint = na
var label sweepLabel = na
var line cthLine = na
var line ctlLine = na

// ติดตาม "จุดทะลุ" ระหว่างชั่วโมงยังไม่จบ (ยังไม่ยืนยันเป็น sweep จนกว่าแท่ง .55 จะปิดกลับเข้ากรอบได้)
var bool pendingSwept = false
var string pendingSide = na
var float pendingPoint = na
var bool pendingOppositeTouched = false // ถ้าแตะฝั่งตรงข้ามระหว่าง pending = ไม่เกิด CRT เลย

// ติดตามว่ามีการทะลุ CTH/CTL ซ้ำระหว่างชั่วโมงหลัง sweep ยืนยันแล้ว (รอแท่ง .55 ปิดตัดสิน fail เหมือนกัน)
var bool rePierced = false

if onHtfChart
    // โหมดชาร์ต HTF: แท่งก่อนหน้า (native) คือแท่งคุมที่เพิ่งปิด ไม่ต้องพึ่ง request.security
    if bar_index > 0
        canAdoptNewCandle = na(crtState) or crtState == "none" or crtState == "success" or crtState == "failed"
        if canAdoptNewCandle
            rangeHigh := high[1]
            rangeLow := low[1]
            rangeHighBar := bar_index - 1
            rangeLowBar := bar_index - 1
            rangeBullish := close[1] > open[1]
            crtState := "none"
            sweptSide := na
            sweepPoint := na
            sweepLabel := na
            cthLine := na
            ctlLine := na
            pendingSwept := false
            pendingSide := na
            pendingPoint := na
            pendingOppositeTouched := false
            rePierced := false

    // ดึงแท่งย่อย (เช่น 5m) ที่ประกอบเป็นแท่ง HTF ปัจจุบัน มาไล่ตรวจ sweep ทีละแท่ง
    [subHigh, subLow, subClose] = request.security_lower_tf(syminfo.tickerid, ltf, [high, low, close])
    n = array.size(subHigh)
    if not na(rangeHigh) and n > 0
        for i = 0 to n - 1
            h_ = array.get(subHigh, i)
            l_ = array.get(subLow, i)
            c_ = array.get(subClose, i)
            subConfirmed = barstate.isconfirmed or i < n - 1
            isLastSubBar = i == n - 1

            if crtState == "swept" and showOngoing
                if na(cthLine)
                    cthLine := line.new(rangeHighBar, rangeHigh, bar_index, rangeHigh, color=hlColor, width=hlWidth)
                    ctlLine := line.new(rangeLowBar, rangeLow, bar_index, rangeLow, color=hlColor, width=hlWidth)
                else
                    line.set_x2(cthLine, bar_index)
                    line.set_x2(ctlLine, bar_index)

            if crtState == "none"
                // ไล่หาจุดทะลุระหว่างชั่วโมง (ยังไม่ยืนยัน) — เก็บจุดสุดขั้วไว้ก่อน
                if not pendingSwept
                    if rangeBullish and h_ > rangeHigh
                        pendingSwept := true
                        pendingSide := "high"
                        pendingPoint := h_
                    else if not rangeBullish and l_ < rangeLow
                        pendingSwept := true
                        pendingSide := "low"
                        pendingPoint := l_
                else
                    if pendingSide == "high" and h_ > pendingPoint
                        pendingPoint := h_
                    if pendingSide == "low" and l_ < pendingPoint
                        pendingPoint := l_
                    // ถ้าแตะฝั่งตรงข้ามระหว่าง pending (ก่อนแท่ง .55 ปิด) = ไม่เหลือช่องว่างให้วิ่ง ไม่เกิด CRT เลย
                    if (pendingSide == "low" and h_ >= rangeHigh) or (pendingSide == "high" and l_ <= rangeLow)
                        pendingOppositeTouched := true

                // ยืนยัน sweep ได้ก็ต่อเมื่อแท่งย่อยสุดท้ายของชั่วโมง (.55) ปิดกลับเข้ากรอบได้ และไม่เคยแตะฝั่งตรงข้ามมาก่อนเลย
                if isLastSubBar and subConfirmed and crtState == "none"
                    if pendingSwept and not pendingOppositeTouched and ((pendingSide == "high" and c_ <= rangeHigh) or (pendingSide == "low" and c_ >= rangeLow))
                        crtState := "swept"
                        sweptSide := pendingSide
                        sweepPoint := pendingPoint
                        if showOngoing
                            sweepLabel := label.new(bar_index, pendingPoint, "Sweep", style=pendingSide == "high" ? label.style_label_down : label.style_label_up, color=color.blue, textcolor=color.white, size=size.small)
                    // ไม่ปิดกลับเข้ากรอบ หรือเคยแตะฝั่งตรงข้ามมาก่อน = ไม่นับเป็น CRT เลย ทิ้ง pending ทิ้ง
                    pendingSwept := false
                    pendingSide := na
                    pendingPoint := na
                    pendingOppositeTouched := false
            else if crtState == "swept"
                touchOpposite = (sweptSide == "low" and h_ >= rangeHigh) or (sweptSide == "high" and l_ <= rangeLow)
                if touchOpposite
                    crtState := "success"
                    if not na(sweepLabel)
                        label.delete(sweepLabel)
                        sweepLabel := na
                    if showSuccess
                        if na(cthLine)
                            line.new(rangeHighBar, rangeHigh, bar_index, rangeHigh, color=hlColor, width=hlWidth)
                            line.new(rangeLowBar, rangeLow, bar_index, rangeLow, color=hlColor, width=hlWidth)
                        else
                            line.set_x2(cthLine, bar_index)
                            line.set_x2(ctlLine, bar_index)
                    else if not na(cthLine)
                        line.delete(cthLine)
                        line.delete(ctlLine)
                        cthLine := na
                        ctlLine := na
                    if showSuccess
                        label.new(bar_index, sweptSide == "low" ? rangeHigh : rangeLow, "Success", style=sweptSide == "low" ? label.style_label_down : label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
                else
                    // ทะลุ CTH/CTL ซ้ำระหว่างชั่วโมง — เก็บไว้ก่อน รอแท่ง .55 ปิดค่อยตัดสิน fail
                    beyondSweep = (sweptSide == "low" and l_ < rangeLow) or (sweptSide == "high" and h_ > rangeHigh)
                    if beyondSweep
                        rePierced := true
                        sweepPoint := sweptSide == "low" ? math.min(sweepPoint, l_) : math.max(sweepPoint, h_)
                    if isLastSubBar and subConfirmed and rePierced
                        closedInside = (sweptSide == "low" and c_ >= rangeLow) or (sweptSide == "high" and c_ <= rangeHigh)
                        if closedInside
                            rePierced := false
                        else
                            crtState := "failed"
                            rePierced := false
                            if not na(sweepLabel)
                                label.delete(sweepLabel)
                                sweepLabel := na
                            if showFailed
                                if na(cthLine)
                                    line.new(rangeHighBar, rangeHigh, bar_index, rangeHigh, color=hlColor, width=hlWidth)
                                    line.new(rangeLowBar, rangeLow, bar_index, rangeLow, color=hlColor, width=hlWidth)
                                else
                                    line.set_x2(cthLine, bar_index)
                                    line.set_x2(ctlLine, bar_index)
                            else if not na(cthLine)
                                line.delete(cthLine)
                                line.delete(ctlLine)
                                cthLine := na
                                ctlLine := na
                            if showFailed
                                label.new(bar_index, sweptSide == "low" ? l_ : h_, "Failed", style=sweptSide == "low" ? label.style_label_down : label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
else
    if isNewHtfBar and bar_index > 0
        // ยืนยัน sweep ได้ก็ต่อเมื่อแท่ง .55 ปิดกลับเข้ากรอบได้ และไม่เคยแตะฝั่งตรงข้ามมาก่อนเลย
        if crtState == "none" and not na(rangeHigh)
            if pendingSwept and not pendingOppositeTouched and ((pendingSide == "high" and close[1] <= rangeHigh) or (pendingSide == "low" and close[1] >= rangeLow))
                crtState := "swept"
                sweptSide := pendingSide
                sweepPoint := pendingPoint
                if showOngoing
                    sweepLabel := label.new(bar_index - 1, pendingPoint, "Sweep", style=pendingSide == "high" ? label.style_label_down : label.style_label_up, color=color.blue, textcolor=color.white, size=size.small)
            // ไม่ปิดกลับเข้ากรอบ หรือเคยแตะฝั่งตรงข้ามมาก่อน = ไม่นับเป็น CRT เลย ทิ้ง pending ทิ้ง
            pendingSwept := false
            pendingSide := na
            pendingPoint := na
            pendingOppositeTouched := false

        // ยืนยัน fail ก็ต่อเมื่อแท่ง .55 ปิดแล้วเช่นกัน (สมมาตรกับตอนยืนยัน sweep)
        if crtState == "swept" and rePierced
            closedInside = (sweptSide == "low" and close[1] >= rangeLow) or (sweptSide == "high" and close[1] <= rangeHigh)
            if closedInside
                rePierced := false
            else
                crtState := "failed"
                rePierced := false
                if not na(sweepLabel)
                    label.delete(sweepLabel)
                    sweepLabel := na
                if showFailed
                    if na(cthLine)
                        line.new(rangeHighBar, rangeHigh, bar_index - 1, rangeHigh, color=hlColor, width=hlWidth)
                        line.new(rangeLowBar, rangeLow, bar_index - 1, rangeLow, color=hlColor, width=hlWidth)
                    else
                        line.set_x2(cthLine, bar_index - 1)
                        line.set_x2(ctlLine, bar_index - 1)
                else if not na(cthLine)
                    line.delete(cthLine)
                    line.delete(ctlLine)
                    cthLine := na
                    ctlLine := na
                if showFailed
                    label.new(bar_index - 1, sweptSide == "low" ? low[1] : high[1], "Failed", style=sweptSide == "low" ? label.style_label_down : label.style_label_up, color=color.red, textcolor=color.white, size=size.small)

        // เปลี่ยนไปใช้แท่งที่ปิดล่าสุดเป็นแท่งคุมใหม่ ได้ก็ต่อเมื่อกรอบเดิมรู้ผลแล้ว (หรือยังไม่เคย sweep)
        canAdoptNewCandle = na(crtState) or crtState == "none" or crtState == "success" or crtState == "failed"
        if canAdoptNewCandle
            rangeHigh := curCandleHigh
            rangeLow := curCandleLow
            rangeHighBar := curCandleHighBar
            rangeLowBar := curCandleLowBar
            rangeBullish := htfClose[1] > htfOpen[1]
            crtState := "none"
            sweptSide := na
            sweepPoint := na
            sweepLabel := na
            cthLine := na
            ctlLine := na
            pendingSwept := false
            pendingSide := na
            pendingPoint := na
            pendingOppositeTouched := false
            rePierced := false
        // ถ้ากรอบเดิมยัง "swept" ไม่รู้ผล ไม่แตะแท่งใหม่นี้ เฝ้ากรอบเดิมต่อ

        // เริ่มติดตามแท่ง HTF ใหม่ที่กำลังฟอร์มตัว (candidate สำหรับรอบหน้า)
        curCandleHigh := high
        curCandleHighBar := bar_index
        curCandleLow := low
        curCandleLowBar := bar_index
    else
        // อัปเดตตำแหน่ง high/low สุดของแท่ง HTF ที่กำลังฟอร์มตัว
        if na(curCandleHigh) or high > curCandleHigh
            curCandleHigh := high
            curCandleHighBar := bar_index
        if na(curCandleLow) or low < curCandleLow
            curCandleLow := low
            curCandleLowBar := bar_index

    // เช็ค pending/touchOpposite/beyondSweep ของแท่งปัจจุบัน — เขียนครั้งเดียว รันทุกแท่งไม่ว่าจะเป็นแท่งแรกของชั่วโมงหรือไม่
    // (กันบั๊กแบบที่เคยพลาด: แท่งแรกของชั่วโมงไม่ถูกเช็คเพราะ logic ซ้ำกันอยู่คนละที่)
    if not na(rangeHigh)
        // เส้น CTH/CTL ระหว่างกำลังเฝ้า (swept ยังไม่รู้ผล) โชว์/ยืดสดตาม toggle
        if crtState == "swept" and showOngoing
            if na(cthLine)
                cthLine := line.new(rangeHighBar, rangeHigh, bar_index, rangeHigh, color=hlColor, width=hlWidth)
                ctlLine := line.new(rangeLowBar, rangeLow, bar_index, rangeLow, color=hlColor, width=hlWidth)
            else
                line.set_x2(cthLine, bar_index)
                line.set_x2(ctlLine, bar_index)

        if crtState == "none"
            // ไล่หาจุดทะลุระหว่างชั่วโมง (ยังไม่ยืนยัน) — เก็บจุดสุดขั้วไว้ก่อน
            if not pendingSwept
                if rangeBullish and high > rangeHigh
                    pendingSwept := true
                    pendingSide := "high"
                    pendingPoint := high
                else if not rangeBullish and low < rangeLow
                    pendingSwept := true
                    pendingSide := "low"
                    pendingPoint := low
            else
                if pendingSide == "high" and high > pendingPoint
                    pendingPoint := high
                if pendingSide == "low" and low < pendingPoint
                    pendingPoint := low
                // ถ้าแตะฝั่งตรงข้ามระหว่าง pending (ก่อนแท่ง .55 ปิด) = ไม่เหลือช่องว่างให้วิ่ง ไม่เกิด CRT เลย
                if (pendingSide == "low" and high >= rangeHigh) or (pendingSide == "high" and low <= rangeLow)
                    pendingOppositeTouched := true
        else if crtState == "swept"
            touchOpposite = (sweptSide == "low" and high >= rangeHigh) or (sweptSide == "high" and low <= rangeLow)
            if touchOpposite
                crtState := "success"
                if not na(sweepLabel)
                    label.delete(sweepLabel)
                    sweepLabel := na
                if showSuccess
                    if na(cthLine)
                        line.new(rangeHighBar, rangeHigh, bar_index, rangeHigh, color=hlColor, width=hlWidth)
                        line.new(rangeLowBar, rangeLow, bar_index, rangeLow, color=hlColor, width=hlWidth)
                    else
                        line.set_x2(cthLine, bar_index)
                        line.set_x2(ctlLine, bar_index)
                else if not na(cthLine)
                    line.delete(cthLine)
                    line.delete(ctlLine)
                    cthLine := na
                    ctlLine := na
                if showSuccess
                    label.new(bar_index, sweptSide == "low" ? rangeHigh : rangeLow, "Success", style=sweptSide == "low" ? label.style_label_down : label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
            else
                // ทะลุ CTH/CTL ซ้ำระหว่างชั่วโมง — เก็บไว้ก่อน รอแท่ง .55 ปิดค่อยตัดสิน fail
                beyondSweep = (sweptSide == "low" and low < rangeLow) or (sweptSide == "high" and high > rangeHigh)
                if beyondSweep
                    rePierced := true
                    sweepPoint := sweptSide == "low" ? math.min(sweepPoint, low) : math.max(sweepPoint, high)
